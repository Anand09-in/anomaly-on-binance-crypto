# ── Kafka ─────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_RAW_TOPIC=raw-trades
KAFKA_KLINE_10S_TOPIC=kline-10s
KAFKA_KLINE_1M_TOPIC=kline-1m
KAFKA_ANOMALY_TOPIC=anomaly-alerts

# ── Binance producer ───────────────────────────────────────────────
SYMBOLS=btcusdt,ethusdt,solusdt,bnbusdt
WS_STREAM_TYPE=trade

# ── Postgres ───────────────────────────────────────────────────────
POSTGRES_DSN=postgresql://anomaly:anomaly@localhost:5432/anomaly

# ── MLflow ─────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=binance-anomaly

# ── Flink anomaly thresholds ───────────────────────────────────────
PRICE_SPIKE_PCT=2.0          # flag if |price_change_pct| > this
VOLUME_SPIKE_MULT=5.0        # flag if volume > rolling_avg * this
ROLLING_WINDOW=30            # number of klines in rolling stats

# ── Observability ─────────────────────────────────────────────────
METRICS_PORT=8000
REPORTS_PATH=data/reports
DRIFT_WINDOW_HOURS=24        # hours of reference data for Evidently

# ── Grafana ───────────────────────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=anomaly
